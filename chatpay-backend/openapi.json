{
  "openapi": "3.1.0",
  "info": {
    "title": "ChatPay Backend API",
    "description": "Chat-based Stellar Testnet payments API specification",
    "version": "0.2.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provide JWT session token obtained via POST /auth/verify"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/auth/challenge": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "Request a single-use expiring authentication challenge for a Stellar public key",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "publicKey": {
                    "type": "string",
                    "minLength": 56,
                    "maxLength": 56,
                    "description": "Stellar ed25519 public key (G...)"
                  }
                },
                "required": [
                  "publicKey"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challenge": {
                      "type": "string"
                    },
                    "nonce": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "challenge",
                    "nonce",
                    "expiresAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "description": "Submit wallet signature for authentication challenge and obtain JWT bearer session token",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "publicKey": {
                    "type": "string",
                    "minLength": 56,
                    "maxLength": 56
                  },
                  "signature": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nonce": {
                    "type": "string"
                  }
                },
                "required": [
                  "publicKey",
                  "signature"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "publicKey": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "publicKey"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "token",
                    "user"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/me/wallet": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "description": "Get connected account XLM and USDC balances and trustline status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "publicKey": {
                      "type": "string"
                    },
                    "exists": {
                      "type": "boolean"
                    },
                    "nativeBalance": {
                      "type": "string"
                    },
                    "usdcBalance": {
                      "type": "string"
                    },
                    "hasUsdcTrustline": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "publicKey",
                    "exists",
                    "nativeBalance",
                    "usdcBalance",
                    "hasUsdcTrustline"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/recipients": {
      "get": {
        "tags": [
          "Recipients"
        ],
        "description": "List all recipients in the authenticated user's address book",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "alias": {
                        "type": "string"
                      },
                      "address": {
                        "type": "string"
                      },
                      "createdAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "updatedAt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "warnings": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "alias",
                      "address",
                      "createdAt",
                      "updatedAt"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Recipients"
        ],
        "description": "Add a new recipient alias and Stellar address to your address book",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alias": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50,
                    "description": "User-friendly alias (e.g. Alex)"
                  },
                  "address": {
                    "type": "string",
                    "minLength": 56,
                    "maxLength": 56,
                    "description": "Stellar ed25519 public key (G...)"
                  }
                },
                "required": [
                  "alias",
                  "address"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "alias": {
                      "type": "string"
                    },
                    "address": {
                      "type": "string"
                    },
                    "createdAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "updatedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "alias",
                    "address",
                    "createdAt",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/recipients/{id}": {
      "patch": {
        "tags": [
          "Recipients"
        ],
        "description": "Edit a recipient alias or address",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alias": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "address": {
                    "type": "string",
                    "minLength": 56,
                    "maxLength": 56
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "alias": {
                      "type": "string"
                    },
                    "address": {
                      "type": "string"
                    },
                    "createdAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "updatedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "id",
                    "alias",
                    "address",
                    "createdAt",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Recipients"
        ],
        "description": "Delete a recipient from your address book",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "enum": [
                    "null"
                  ],
                  "nullable": true
                }
              }
            }
          }
        }
      }
    },
    "/commands": {
      "post": {
        "tags": [
          "Commands"
        ],
        "description": "Process natural-language payment command text and return transaction preview or clarification",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Natural language payment instruction (e.g. 'Send 10 USDC to Alex')"
                  },
                  "clientMsgId": {
                    "type": "string",
                    "description": "Unique client message ID for idempotency"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "preview",
                        "clarify",
                        "needs_recipient",
                        "error"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    },
                    "alias": {
                      "type": "string"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "preview": {
                      "type": "object",
                      "properties": {
                        "paymentId": {
                          "type": "string"
                        },
                        "recipientAlias": {
                          "type": "string"
                        },
                        "recipientAddress": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "string"
                        },
                        "asset": {
                          "type": "string"
                        },
                        "estimatedFee": {
                          "type": "string"
                        },
                        "memo": {
                          "type": "string"
                        },
                        "expiresAt": {
                          "type": "string"
                        },
                        "unsignedXdr": {
                          "type": "string"
                        },
                        "warnings": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "paymentId",
                        "recipientAlias",
                        "recipientAddress",
                        "amount",
                        "asset",
                        "estimatedFee",
                        "expiresAt",
                        "unsignedXdr",
                        "warnings"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}/submit": {
      "post": {
        "tags": [
          "Payments"
        ],
        "description": "Submit a signed Stellar transaction XDR for a payment preview",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "signedXdr": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Base64-encoded signed Stellar transaction envelope XDR"
                  }
                },
                "required": [
                  "signedXdr"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "txHash": {
                      "type": "string"
                    },
                    "explorerUrl": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "paymentId",
                    "status",
                    "txHash",
                    "explorerUrl"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "description": "Get status and details of a payment by ID",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "recipientAlias": {
                      "type": "string"
                    },
                    "recipientAddress": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "string"
                    },
                    "assetCode": {
                      "type": "string"
                    },
                    "memo": {
                      "type": "string",
                      "nullable": true
                    },
                    "status": {
                      "type": "string"
                    },
                    "txHash": {
                      "type": "string",
                      "nullable": true
                    },
                    "explorerUrl": {
                      "type": "string",
                      "nullable": true
                    },
                    "createdAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "confirmedAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "string"
                        }
                      ],
                      "nullable": true
                    },
                    "expiresAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    "failureCode": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "id",
                    "recipientAlias",
                    "recipientAddress",
                    "amount",
                    "assetCode",
                    "status",
                    "createdAt",
                    "expiresAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/payments": {
      "get": {
        "tags": [
          "Payments"
        ],
        "description": "List paginated payment history for the user's connected wallet",
        "parameters": [
          {
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "number",
              "minimum": 0,
              "default": 0
            },
            "in": "query",
            "name": "offset",
            "required": false
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "number"
                    },
                    "limit": {
                      "type": "number"
                    },
                    "offset": {
                      "type": "number"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "recipientAlias": {
                            "type": "string"
                          },
                          "recipientAddress": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "string"
                          },
                          "assetCode": {
                            "type": "string"
                          },
                          "memo": {
                            "type": "string",
                            "nullable": true
                          },
                          "status": {
                            "type": "string"
                          },
                          "txHash": {
                            "type": "string",
                            "nullable": true
                          },
                          "explorerUrl": {
                            "type": "string",
                            "nullable": true
                          },
                          "createdAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "string"
                              }
                            ]
                          },
                          "confirmedAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "string"
                              }
                            ],
                            "nullable": true
                          },
                          "failureCode": {
                            "type": "string",
                            "nullable": true
                          }
                        },
                        "required": [
                          "id",
                          "recipientAlias",
                          "recipientAddress",
                          "amount",
                          "assetCode",
                          "status",
                          "createdAt"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "total",
                    "limit",
                    "offset",
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/chat/messages": {
      "get": {
        "tags": [
          "Chat"
        ],
        "description": "Replay or list chat messages since an optional sequence cursor",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "in": "query",
            "name": "since",
            "required": false,
            "description": "Sequence cursor to fetch messages after"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "in": "query",
            "name": "limit",
            "required": false
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "seq": {
                            "type": "number"
                          },
                          "role": {
                            "type": "string",
                            "enum": [
                              "user",
                              "system"
                            ]
                          },
                          "type": {
                            "type": "string"
                          },
                          "payload": {},
                          "clientMsgId": {
                            "type": "string",
                            "nullable": true
                          },
                          "createdAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "string"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "seq",
                          "role",
                          "type",
                          "createdAt"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "messages"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "description": "Service and database health check",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string"
                    },
                    "stellarHorizon": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "timestamp",
                    "version",
                    "database",
                    "stellarHorizon"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development server"
    }
  ]
}