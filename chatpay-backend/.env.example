# ==========================================
# Chatpay Backend - Environment Configuration Template
# ==========================================
# Copy this file to .env and configure your local values.
# NOTE: Do NOT commit actual secrets or live .env files to version control.
# Agents must never read, access, or modify live .env files.

# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME=chatpay-backend

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatpay_db

# Redis / Cache (Optional)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Payment / Third-party Integrations (Placeholders)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key_here
PAYMENT_GATEWAY_SECRET=your_payment_gateway_secret_here
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here
