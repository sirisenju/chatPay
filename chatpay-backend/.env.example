# ==========================================
# Chatpay Backend - Environment Configuration Template
# ==========================================
# Copy this file to .env and configure your local values.
# NOTE: Do NOT commit actual secrets or live .env files to version control.
# Agents must never read, access, or modify live .env files.

# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
APP_NAME=chatpay-backend
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatpay_db

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Stellar Testnet Configuration
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
USDC_ASSET_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
TEST_ISSUER_PUBLIC_KEY=

# Business & Payment Rules
MAX_PAYMENT_CAP=1000
TRANSACTION_TIMEOUT_SECONDS=300

# Natural Language Processing (Optional)
ENABLE_LLM_PARSER=false
ANTHROPIC_API_KEY=your_anthropic_api_key_here
